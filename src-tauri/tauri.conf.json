{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ayst Arc PDF",
  "version": "0.3.1-dev",
  "identifier": "com.minimalpdf.converter",
  "build": {
    "beforeDevCommand": "node_modules/.bin/next dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node_modules/.bin/next build",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Ayst Arc PDF",
        "width": 1080,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "createUpdaterArtifacts": false
  }
}
