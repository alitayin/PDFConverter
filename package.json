{
  "name": "minimal-pdf-converter",
  "version": "0.3.1-dev",
  "private": true,
  "main": "electron/main.cjs",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "pnpm build && electron .",
    "desktop:test": "node --test electron/*.test.mjs",
    "desktop:package:mac": "pnpm build && ./scripts/build-electron-macos.sh",
    "desktop:smoke:mac": "node scripts/smoke-electron-macos.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "typescript": "^5.7.3"
  }
}
